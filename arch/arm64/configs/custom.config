# Disable Samsung Securities
CONFIG_UH=n
CONFIG_UH_RKP=n
CONFIG_UH_LKMAUTH=n
CONFIG_UH_LKM_BLOCK=n
CONFIG_RKP_CFP_JOPP=n
CONFIG_RKP_CFP_ROPP=n
CONFIG_RKP_CFP=n
CONFIG_SECURITY_DEFEX=n
CONFIG_PROCA=n
CONFIG_FIVE=n

# KernelSU Next
CONFIG_KSU=y
CONFIG_KSU_KPROBE_HOOKS=y

# Build settings
CONFIG_WERROR=n
CONFIG_LOCALVERSION="-android12-9"
CONFIG_LOCALVERSION_AUTO=n

# Droidspaces
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_DEVTMPFS=y
# CONFIG_DEVTMPFS_MOUNT is not set
CONFIG_USER_NS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_MACVLAN=y
CONFIG_IP6_NF_NAT=y
CONFIG_IP6_NF_TARGET_MASQUERADE=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_TARGET_REJECT=y
CONFIG_NETFILTER_XT_TARGET_LOG=y
CONFIG_NETFILTER_XT_MATCH_RECENT=y
CONFIG_IP_SET=y
CONFIG_IP_SET_HASH_IP=y
CONFIG_IP_SET_HASH_NET=y
CONFIG_NETFILTER_XT_SET=y

# Exynos 1280 Undervolting Support (sysfs /sys/kernel/exynos_uv/)
CONFIG_SOC_S5E8825_UNDERVOLT=y
CONFIG_SOC_S5E8825_CL0_UV=0
CONFIG_SOC_S5E8825_CL1_UV=0
CONFIG_SOC_S5E8825_GPU_UV=0

# Reduce Syscall Overhead and Crypto Self-Test
CONFIG_AUDITSYSCALL=n
CONFIG_EXYNOS_FMP_INTEGRITY_TEST=n

# TCP Congestion Control & Pacing (BBR + FQ)
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_BBR=y
CONFIG_DEFAULT_BBR=y
CONFIG_DEFAULT_TCP_CONG="bbr"
CONFIG_NET_SCH_DEFAULT=y
CONFIG_DEFAULT_FQ=y
CONFIG_DEFAULT_NET_SCH="fq"
